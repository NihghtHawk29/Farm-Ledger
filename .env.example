# Copy this file to ".env" and fill in your project's values.
# Find these in Supabase Dashboard → Project Settings → Data API (and API Keys).
# Only the "anon" / publishable key belongs here — never the service_role/secret key.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
